{
  "name": "copilot-provider-bridge",
  "displayName": "Copilot Provider Bridge",
  "description": "Enables VS Code Copilot AI features for users via their existing third-party AI coding plans and LLM subscriptions.",
  "version": "0.2.2",
  "publisher": "thejjw",
  "license": "zlib-acknowledgement",
  "repository": {
    "type": "git",
    "url": "https://github.com/thejjw/copilot-provider-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/thejjw/copilot-provider-bridge/issues"
  },
  "homepage": "https://github.com/thejjw/copilot-provider-bridge#readme",
  "funding": {
    "type": "buy-me-a-coffee",
    "url": "https://buymeacoffee.com/thejjw"
  },
  "engines": {
    "vscode": "^1.122.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "copilot",
    "byok",
    "vision",
    "mcp",
    "tools",
    "usage",
    "quota",
    "llm",
    "ai",
    "customendpoint"
  ],
  "icon": "media/icon.png",
  "main": "dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:copilot-provider-bridge.quickSetup",
    "onCommand:copilot-provider-bridge.addModel",
    "onCommand:copilot-provider-bridge.removeModel",
    "onCommand:copilot-provider-bridge.listModels",
    "onCommand:copilot-provider-bridge.configureMcp",
    "onCommand:copilot-provider-bridge.removeMcp",
    "onCommand:copilot-provider-bridge.configureUsageKey",
    "onCommand:copilot-provider-bridge.selectStatusBarProvider",
    "onCommand:copilot-provider-bridge.refreshUsage",
    "onCommand:copilot-provider-bridge.selectVisionModel",
    "onCommand:copilot-provider-bridge.runDiagnostics",
    "onCommand:copilot-provider-bridge.showDebugLogs",
    "onCommand:copilot-provider-bridge.toggleDebugLogging",
    "onCommand:copilot-provider-bridge.resetConfiguration",
    "onCommand:copilot-provider-bridge.customizeCatalog",
    "onCommand:copilot-provider-bridge.openCatalogFile",
    "onCommand:copilot-provider-bridge.reloadCatalog",
    "onCommand:copilot-provider-bridge.migrateCatalog",
    "onCommand:copilot-provider-bridge.resetCatalog"
  ],
  "contributes": {
    "configuration": {
      "title": "Copilot Provider Bridge",
      "properties": {
        "copilotProviderBridge.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose debug logging to Output Channel and local log file for troubleshooting endpoint issues."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "provider_bridge_analyze_visual",
        "displayName": "Analyze Image / Visual Asset (Copilot Provider Bridge)",
        "modelDescription": "Inspect and analyze an image file (PNG, JPG, WebP), UI screenshot, diagram, or mockup. Use this tool when you need visual understanding, OCR text extraction, layout descriptions, or architecture analysis for any image.",
        "icon": "$(eye)",
        "toolReferenceName": "vision",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "file_path": {
              "type": "string",
              "description": "Local workspace-relative or absolute file path to the image file (e.g. './assets/mockup.png')."
            },
            "image_url": {
              "type": "string",
              "description": "Remote image URL (https://...) or base64 data URL."
            },
            "prompt": {
              "type": "string",
              "description": "Specific question, instruction, or analysis goal for the image."
            }
          }
        }
      }
    ],
    "commands": [
      {
        "command": "copilot-provider-bridge.quickSetup",
        "title": "Quick Setup (Models & MCP Tools)",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.addModel",
        "title": "Add Model",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.removeModel",
        "title": "Remove Model",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.listModels",
        "title": "List Models",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.configureMcp",
        "title": "Configure MCP Tools",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.removeMcp",
        "title": "Remove MCP Server",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.configureUsageKey",
        "title": "Configure Usage API Key",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.selectStatusBarProvider",
        "title": "Select Status Bar Provider",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.refreshUsage",
        "title": "Refresh Plan Quotas & Balances",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.selectVisionModel",
        "title": "Select Vision Agent Model",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.runDiagnostics",
        "title": "Run Diagnostics & Connectivity Test",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.showDebugLogs",
        "title": "Show Debug Output Logs",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.toggleDebugLogging",
        "title": "Toggle Debug Logging",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.resetConfiguration",
        "title": "Reset All Configuration & Clear Secrets",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.customizeCatalog",
        "title": "Customize Provider Catalog (Editable Models & Endpoints)",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.openCatalogFile",
        "title": "Open Provider Catalog File",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.reloadCatalog",
        "title": "Reload Provider Catalog",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.migrateCatalog",
        "title": "Migrate Provider Catalog to Latest Defaults",
        "category": "Copilot Provider Bridge"
      },
      {
        "command": "copilot-provider-bridge.resetCatalog",
        "title": "Reset Provider Catalog to Defaults (Delete Customizations)",
        "category": "Copilot Provider Bridge"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "copilot-provider-bridge*.jsonc",
        "url": "./schemas/copilot-provider-bridge.catalog.schema.json"
      }
    ],
